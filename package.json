{
  "name": "@company/excalidraw-skill",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "excalidraw-skill": "./bin/excalidraw-skill.mjs"
  },
  "scripts": {
    "doctor": "node ./bin/excalidraw-skill.mjs doctor",
    "init": "node ./bin/excalidraw-skill.mjs init",
    "test": "node --test ./src/*.test.mjs",
    "smoke": "node ./bin/excalidraw-skill.mjs build examples/service-flow/payment-flow.visual-plan.diagram.json",
    "smoke:v03": "node ./bin/excalidraw-skill.mjs build examples/service-flow/payment-flow.visual-plan.diagram.json",
    "smoke:system": "node ./bin/excalidraw-skill.mjs build examples/system-architecture/layered-middleware.diagram.json",
    "smoke:module": "node ./bin/excalidraw-skill.mjs build examples/module-architecture/connection-manager.diagram.json",
    "candidates": "node ./src/generate-candidates.mjs",
    "preference:record": "node ./src/record-preference.mjs",
    "mcp": "node ./mcp/server.mjs",
    "evaluate": "node ./src/evaluate-suite.mjs",
    "evaluate:strict": "node ./src/evaluate-suite.mjs --strict-perceptual --strict-readability",
    "evaluate:flow": "node ./src/evaluate-suite.mjs --family flow",
    "evaluate:system": "node ./src/evaluate-suite.mjs --family system-architecture",
    "evaluate:module": "node ./src/evaluate-suite.mjs --family module-architecture",
    "editability-report": "node ./src/editability-report.mjs",
    "perceptual-quality-report": "node ./src/perceptual-quality-report.mjs",
    "research:layouts": "node ./src/evaluate-layout-candidates.mjs",
    "visual:actual": "node ./src/render-actual-preview.mjs",
    "visual:actual:suite": "node ./src/render-actual-suite.mjs",
    "visual:verify": "node ./src/verify-actual-render-signatures.mjs",
    "visual:verify:patch": "node ./src/verify-actual-render-signatures.mjs --baseline examples/evaluation/patch-actual-render-baseline.json --render-dir artifacts/patch-actual",
    "skill:install:global": "node ./bin/excalidraw-skill.mjs install --global",
    "skill:doctor:global": "node ./bin/excalidraw-skill.mjs doctor --global",
    "skill:uninstall:global": "node ./bin/excalidraw-skill.mjs uninstall --global"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "elkjs": "^0.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "playwright": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=20.20.0",
    "npm": ">=10"
  },
  "files": [
    "bin",
    "src",
    "mcp",
    "skills",
    ".mcp.json",
    ".opencode",
    ".github/prompts",
    ".github/agents",
    "assets",
    "docs",
    "examples",
    "README.md"
  ]
}

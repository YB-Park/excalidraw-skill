{
  "version": "2.3",
  "name": "professional-software",
  "intent": "Readable, consistent, professional software architecture diagrams.",
  "tokens": {
    "strokeWidth": 2,
    "roughness": 0.7,
    "fontSize": 18,
    "nodeWidth": 180,
    "nodeHeight": 80,
    "rankGap": 280,
    "nodeGap": 140,
    "framePadding": 48,
    "fonts": {
      "default": 2,
      "mono": 3,
      "sketch": 5
    }
  },
  "canvas": {
    "backgroundColor": "#ffffff"
  },
  "base": {
    "strokeColor": "#1f2937",
    "backgroundColor": "#ffffff",
    "fillStyle": "solid",
    "strokeWidth": 2,
    "strokeStyle": "solid",
    "roughness": 0.7,
    "opacity": 100
  },
  "frame": {
    "strokeColor": "#9ca3af",
    "backgroundColor": "#f8fafc",
    "fillStyle": "solid",
    "strokeWidth": 1,
    "strokeStyle": "solid",
    "roughness": 0.6,
    "opacity": 100
  },
  "edgeLabel": {
    "strokeColor": "#374151",
    "initialBackgroundColor": "transparent",
    "placedBackgroundColor": "#ffffff",
    "fontSize": 13,
    "lineHeight": 1.25
  },
  "roles": {
    "actor": {"strokeColor": "#475569", "backgroundColor": "#f8fafc"},
    "client": {"strokeColor": "#475569", "backgroundColor": "#f8fafc"},
    "gateway": {"strokeColor": "#2563eb", "backgroundColor": "#eff6ff"},
    "service": {"strokeColor": "#4f46e5", "backgroundColor": "#eef2ff"},
    "worker": {"strokeColor": "#7c3aed", "backgroundColor": "#f5f3ff"},
    "data": {"strokeColor": "#0f766e", "backgroundColor": "#f0fdfa"},
    "cache": {"strokeColor": "#16a34a", "backgroundColor": "#f0fdf4"},
    "queue": {"strokeColor": "#9333ea", "backgroundColor": "#faf5ff"},
    "external": {"strokeColor": "#64748b", "backgroundColor": "#f8fafc"},
    "risk": {"strokeColor": "#d97706", "backgroundColor": "#fffbeb"},
    "model": {"strokeColor": "#334155", "backgroundColor": "#f8fafc"},
    "boundary": {"strokeColor": "#cbd5e1", "backgroundColor": "#f8fafc"}
  },
  "edgeKinds": {
    "calls": {"strokeColor": "#2563eb", "strokeStyle": "solid", "strokeWidth": 2, "role": "runtime-call"},
    "sync": {"strokeColor": "#2563eb", "strokeStyle": "solid", "strokeWidth": 2, "role": "runtime-call"},
    "returns": {"strokeColor": "#64748b", "strokeStyle": "dashed", "strokeWidth": 2, "role": "return"},
    "depends-on": {"strokeColor": "#64748b", "strokeStyle": "dashed", "strokeWidth": 2, "role": "dependency"},
    "references": {"strokeColor": "#64748b", "strokeStyle": "dashed", "strokeWidth": 2, "role": "dependency"},
    "contains": {"strokeColor": "#94a3b8", "strokeStyle": "dotted", "strokeWidth": 2, "role": "containment"},
    "async": {"strokeColor": "#7c3aed", "strokeStyle": "dashed", "strokeWidth": 2, "role": "async"},
    "publishes": {"strokeColor": "#7c3aed", "strokeStyle": "dashed", "strokeWidth": 2, "role": "async"},
    "subscribes": {"strokeColor": "#7c3aed", "strokeStyle": "dashed", "strokeWidth": 2, "role": "async"},
    "reads": {"strokeColor": "#0f766e", "strokeStyle": "solid", "strokeWidth": 2, "role": "data-read"},
    "writes": {"strokeColor": "#b45309", "strokeStyle": "solid", "strokeWidth": 2, "role": "data-write"},
    "transfers": {"strokeColor": "#0284c7", "strokeStyle": "solid", "strokeWidth": 2, "role": "data-transfer"},
    "controls": {"strokeColor": "#334155", "strokeStyle": "solid", "strokeWidth": 2, "role": "control"},
    "interrupts": {"strokeColor": "#dc2626", "strokeStyle": "dashed", "strokeWidth": 2, "role": "interrupt"},
    "retries": {"strokeColor": "#d97706", "strokeStyle": "dashed", "strokeWidth": 2, "role": "retry"},
    "fails-to": {"strokeColor": "#dc2626", "strokeStyle": "dashed", "strokeWidth": 2, "role": "failure"},
    "optional": {"strokeColor": "#64748b", "strokeStyle": "dashed", "strokeWidth": 2, "role": "optional"}
  },
  "edgeVisualRoles": {
    "default": {"strokeColor": "#1f2937", "strokeWidth": 2, "strokeStyle": "solid", "opacity": 100},
    "data-plane": {"strokeColor": "#2563eb", "strokeWidth": 3, "strokeStyle": "solid", "opacity": 100},
    "control-plane": {"strokeColor": "#7c3aed", "strokeWidth": 2, "strokeStyle": "solid", "opacity": 100},
    "event-stream": {"strokeColor": "#0891b2", "strokeWidth": 2, "strokeStyle": "dashed", "opacity": 100},
    "error-path": {"strokeColor": "#dc2626", "strokeWidth": 3, "strokeStyle": "dashed", "opacity": 100},
    "dependency": {"strokeColor": "#64748b", "strokeWidth": 2, "strokeStyle": "solid", "opacity": 100},
    "muted": {"strokeColor": "#94a3b8", "strokeWidth": 1, "strokeStyle": "solid", "opacity": 70}
  },
  "edgeEmphasis": {
    "normal": {},
    "strong": {"strokeWidthDelta": 1},
    "critical": {"strokeColor": "#dc2626", "strokeWidth": 4, "opacity": 100},
    "muted": {"strokeColor": "#94a3b8", "strokeWidth": 1, "opacity": 70}
  },
  "componentDetails": {
    "base": {"strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0.7, "opacity": 100},
    "text": {"strokeColor": "#475569"},
    "database": {"strokeColor": "#0f766e", "tagFill": "#ccfbf1"},
    "queue": {"strokeColor": "#9333ea", "bandFill": "#f3e8ff", "labelStroke": "#7e22ce"},
    "external": {"strokeColor": "#64748b", "tagFill": "#f1f5f9"},
    "risk": {"strokeColor": "#d97706", "badgeFill": "#fef3c7", "textStroke": "#b45309"},
    "worker": {"strokeColor": "#7c3aed", "tagFill": "#ede9fe"},
    "state": {"strokeColor": "#334155", "tagFill": "#f1f5f9", "separator": "#94a3b8"},
    "entity": {"strokeColor": "#334155", "tagFill": "#f8fafc", "separator": "#cbd5e1"},
    "process": {"strokeColor": "#475569", "tagFill": "#f8fafc", "accent": "#64748b"},
    "sequence": {"strokeColor": "#2563eb", "tagFill": "#dbeafe", "lifeline": "#94a3b8"},
    "deployment": {"strokeColor": "#94a3b8", "tagStroke": "#64748b", "tagFill": "#f1f5f9"},
    "gateway": {"strokeColor": "#2563eb", "tagFill": "#dbeafe"},
    "actor": {"strokeColor": "#475569"},
    "service": {"strokeColor": "#4f46e5"}
  }
}

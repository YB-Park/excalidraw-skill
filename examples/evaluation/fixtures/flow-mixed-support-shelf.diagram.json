    {"semanticId":"ingress","label":"Ingress","shapeRef":"gateway.api","layoutHints":{"lane":"main","rank":0,"importance":"primary"}},
    {"semanticId":"orchestrate","label":"Orchestrator","shapeRef":"service.backend","layoutHints":{"lane":"main","rank":1,"importance":"primary"}},
    {"semanticId":"deliver","label":"Delivery Worker","shapeRef":"service.worker","layoutHints":{"lane":"main","rank":3,"importance":"primary"}},
    {"semanticId":"ack","label":"Acknowledged","shapeRef":"client.web","layoutHints":{"lane":"main","rank":4,"importance":"primary"}},
    {"semanticId":"config","label":"Config Store","shapeRef":"data.store","layoutHints":{"lane":"upper","rank":1,"importance":"secondary"}},
    {"semanticId":"metrics","label":"Metrics Sink","shapeRef":"telemetry.metrics","layoutHints":{"lane":"upper","rank":3,"importance":"secondary"}},
    {"semanticId":"queue","label":"Delivery Queue","shapeRef":"queue.event","layoutHints":{"lane":"lower","rank":2,"importance":"secondary"}},
    {"semanticId":"deadletter","label":"Dead Letter","shapeRef":"queue.event","layoutHints":{"lane":"lower","rank":3,"importance":"secondary"}}

{
  "version":"2.0",
  "diagramType":"event-flow",
  "title":"Mixed Support Shelf",
  "stylePreset":"professional-software",
  "layout":{"profile":"swimlane-flow","direction":"left-to-right","aspectRatio":"balanced","primaryFlow":["ingress","orchestrate","deliver","ack"],"lanes":[{"id":"upper","position":"top","order":0},{"id":"main","position":"center","order":1},{"id":"lower","position":"bottom","order":2}]},
  "framePolicy":{"mode":"none"},

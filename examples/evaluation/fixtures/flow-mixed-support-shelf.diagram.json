  "edges":[
    {"semanticId":"ingress-orchestrate","from":"ingress","to":"orchestrate","label":"dispatch","kind":"calls","routeHints":{"priority":"primary"}},
    {"semanticId":"orchestrate-deliver","from":"orchestrate","to":"deliver","label":"execute","kind":"calls","routeHints":{"priority":"primary"}},
    {"semanticId":"deliver-ack","from":"deliver","to":"ack","label":"complete","kind":"returns","routeHints":{"priority":"primary"}},
    {"semanticId":"config-orchestrate","from":"config","to":"orchestrate","label":"settings","kind":"reads","routeHints":{"direction":"down","priority":"secondary"}},
    {"semanticId":"orchestrate-queue","from":"orchestrate","to":"queue","label":"enqueue","kind":"async","routeHints":{"direction":"down","priority":"secondary"}},
    {"semanticId":"queue-deliver","from":"queue","to":"deliver","label":"dequeue","kind":"async","routeHints":{"direction":"up","priority":"secondary"}},
    {"semanticId":"deliver-metrics","from":"deliver","to":"metrics","label":"observe","kind":"writes","routeHints":{"direction":"up","priority":"secondary"}},
    {"semanticId":"deliver-deadletter","from":"deliver","to":"deadletter","label":"failure","kind":"failure","routeHints":{"direction":"down","priority":"secondary"}}

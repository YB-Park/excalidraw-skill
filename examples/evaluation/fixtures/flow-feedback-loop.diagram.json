{
  "version":"2.0",
  "diagramType":"event-flow",
  "title":"Delivery With Feedback",
  "stylePreset":"professional-software",
  "layout":{"profile":"swimlane-flow","direction":"left-to-right","aspectRatio":"balanced","primaryFlow":["producer","topic","consumer","delivery"],"lanes":[{"id":"main","position":"center","order":0},{"id":"support","position":"bottom","order":1}]},
  "framePolicy":{"mode":"none"},
  "nodes":[
    {"semanticId":"producer","label":"Producer","shapeRef":"service.backend","layoutHints":{"lane":"main","rank":0,"importance":"primary"}},
    {"semanticId":"topic","label":"Delivery Topic","shapeRef":"queue.topic","layoutHints":{"lane":"main","rank":1,"importance":"primary"}},
    {"semanticId":"consumer","label":"Delivery Consumer","shapeRef":"service.worker","layoutHints":{"lane":"main","rank":2,"importance":"primary"}},
    {"semanticId":"delivery","label":"External Delivery","shapeRef":"external.system","layoutHints":{"lane":"main","rank":3,"importance":"primary"}},
    {"semanticId":"retry","label":"Retry Queue","shapeRef":"queue.topic","layoutHints":{"lane":"support","rank":2,"importance":"secondary"}},
    {"semanticId":"state","label":"Attempt State","shapeRef":"database.relational","layoutHints":{"lane":"support","rank":2,"importance":"support"}},
    {"semanticId":"metrics","label":"Delivery Metrics","shapeRef":"service.backend","layoutHints":{"lane":"support","rank":3,"importance":"support"}}
  ],
  "edges":[
    {"semanticId":"producer-topic","from":"producer","to":"topic","label":"publish","kind":"async","routeHints":{"priority":"primary"}},
    {"semanticId":"topic-consumer","from":"topic","to":"consumer","label":"consume","kind":"async","routeHints":{"priority":"primary"}},
    {"semanticId":"consumer-delivery","from":"consumer","to":"delivery","label":"deliver","kind":"calls","routeHints":{"priority":"primary"}},
    {"semanticId":"consumer-retry","from":"consumer","to":"retry","label":"temporary failure","kind":"retry","routeHints":{"direction":"down","priority":"secondary"}},
    {"semanticId":"retry-consumer","from":"retry","to":"consumer","label":"retry","kind":"retry","routeHints":{"direction":"up","priority":"secondary"}},
    {"semanticId":"consumer-state","from":"consumer","to":"state","label":"record attempt","kind":"writes","routeHints":{"direction":"down","priority":"secondary"}},
    {"semanticId":"delivery-metrics","from":"delivery","to":"metrics","label":"result","kind":"transfers","routeHints":{"direction":"down","priority":"secondary"}}
  ],
  "outputPath":"examples/evaluation/outputs/flow-feedback-loop.excalidraw"
}

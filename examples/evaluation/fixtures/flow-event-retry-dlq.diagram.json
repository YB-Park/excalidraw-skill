{
  "version": "2.0",
  "diagramType": "event-flow",
  "title": "Order Event Retry and Dead Letter Flow",
  "stylePreset": "professional-software",
  "layout": {
    "profile": "swimlane-flow",
    "direction": "left-to-right",
    "aspectRatio": "balanced",
    "primaryFlow": ["producer", "orders-topic", "order-consumer", "order-store"],
    "lanes": [
      {"id": "main", "label": "Normal Processing", "position": "center", "order": 0},
      {"id": "recovery", "label": "Retry and Failure", "position": "bottom", "order": 1}
    ]
  },
  "framePolicy": {"mode": "none"},
  "nodes": [
    {
      "semanticId": "producer",
      "label": "Producer",
      "shapeRef": "service.backend",
      "layoutHints": {"lane": "main", "rank": 0, "importance": "primary"}
    },
    {
      "semanticId": "orders-topic",
      "label": "Orders Topic",
      "shapeRef": "queue.topic",
      "fontRole": "mono",
      "layoutHints": {"lane": "main", "rank": 1, "importance": "primary"}
    },
    {
      "semanticId": "order-consumer",
      "label": "Order Consumer",
      "shapeRef": "service.worker",
      "layoutHints": {"lane": "main", "rank": 2, "importance": "primary"}
    },
    {
      "semanticId": "order-store",
      "label": "Order Store",
      "shapeRef": "database.relational",
      "layoutHints": {"lane": "main", "rank": 3, "importance": "primary"}
    },
    {
      "semanticId": "retry-queue",
      "label": "Retry Queue",
      "shapeRef": "queue.topic",
      "fontRole": "mono",
      "layoutHints": {"lane": "recovery", "rank": 2, "importance": "secondary"}
    },
    {
      "semanticId": "dead-letter-queue",
      "label": "Dead Letter Queue",
      "shapeRef": "queue.topic",
      "fontRole": "mono",
      "layoutHints": {"lane": "recovery", "rank": 3, "importance": "support"}
    },
    {
      "semanticId": "alerting-service",
      "label": "Alerting Service",
      "shapeRef": "service.backend",
      "layoutHints": {"lane": "recovery", "rank": 4, "importance": "support"}
    }
  ],
  "edges": [
    {"semanticId": "producer-publishes", "from": "producer", "to": "orders-topic", "label": "publish", "kind": "publishes", "routeHints": {"priority": "primary", "labelSide": "above"}},
    {"semanticId": "consumer-subscribes", "from": "orders-topic", "to": "order-consumer", "label": "consume", "kind": "subscribes", "routeHints": {"priority": "primary", "labelSide": "above"}},
    {"semanticId": "consumer-writes", "from": "order-consumer", "to": "order-store", "label": "persist", "kind": "writes", "routeHints": {"priority": "primary", "labelSide": "above"}},
    {"semanticId": "consumer-retries", "from": "order-consumer", "to": "retry-queue", "label": "transient failure", "kind": "retries", "routeHints": {"direction": "down", "priority": "secondary", "labelSide": "right"}},
    {"semanticId": "retry-redelivers", "from": "retry-queue", "to": "order-consumer", "label": "redeliver", "kind": "publishes", "routeHints": {"direction": "up", "priority": "secondary", "labelSide": "left"}},
    {"semanticId": "retry-to-dlq", "from": "retry-queue", "to": "dead-letter-queue", "label": "retries exhausted", "kind": "fails-to", "routeHints": {"direction": "right", "priority": "secondary", "labelSide": "above"}},
    {"semanticId": "dlq-alerts", "from": "dead-letter-queue", "to": "alerting-service", "label": "notify", "kind": "publishes", "routeHints": {"direction": "right", "priority": "secondary", "labelSide": "above"}}
  ],
  "outputPath": "examples/evaluation/outputs/flow-event-retry-dlq.excalidraw"
}
